{% doc %}
  @prompt
    Create a modern About Us section for a Shopify clothing brand.
    
    Layout: Two-column layout
    
    Left side: A high-quality, minimalist lifestyle image featuring random premium t-shirts (neutral colors like black, white, beige). The image should feel exclusive, modern, and streetwear-inspired, with soft lighting and a clean background.
    
    Right side: Text content, aligned center-left, with a bold heading and short paragraph.
    
    Brand vibe: Private club, exclusive, limited access, premium streetwear, modern, minimal, confident.
    
    Text content (use exactly this wording):
    
    Entitled Club is a private clothing brand. Entry is granted. Product is selected and released in limited runs, with quality placed above quantity.
    
    Style: High-end fashion brand, luxury streetwear, minimal typography, lots of white space, calm and confident tone.
    
    Overall feel: Exclusive, curated, members-only energy., please check that in th section background i want gradient grey color but now there is showing slider please block that slider when second section end 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-about-section-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    position: relative;
    isolation: isolate;
    {% if block.settings.use_gradient %}
      background: linear-gradient(
        {{ block.settings.gradient_direction }}deg,
        {{ block.settings.gradient_color_1 }},
        {{ block.settings.gradient_color_2 }}
      );
    {% else %}
      background-color: {{ block.settings.background_color }};
    {% endif %}
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-about-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }

  .ai-about-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: {{ block.settings.column_gap }}px;
    align-items: center;
  }

  .ai-about-image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-about-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
  }

  .ai-about-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-about-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-about-content-{{ ai_gen_id }} {
    padding: {{ block.settings.content_padding }}px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-about-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
    letter-spacing: {{ block.settings.heading_letter_spacing }}px;
    text-transform: {{ block.settings.heading_transform }};
  }

  .ai-about-text-{{ ai_gen_id }} {
    font-size: {{ block.settings.text_size }}px;
    font-weight: {{ block.settings.text_weight }};
    color: {{ block.settings.text_color }};
    line-height: {{ block.settings.text_line_height }};
    margin: 0;
    letter-spacing: {{ block.settings.text_letter_spacing }}px;
  }

  @media screen and (max-width: 768px) {
    .ai-about-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.mobile_gap }}px;
    }

    .ai-about-content-{{ ai_gen_id }} {
      padding: {{ block.settings.mobile_content_padding }}px;
    }

    .ai-about-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_heading_size }}px;
    }

    .ai-about-text-{{ ai_gen_id }} {
      font-size: {{ block.settings.mobile_text_size }}px;
    }
  }
{% endstyle %}

<div class="ai-about-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-about-container-{{ ai_gen_id }}">
    <div class="ai-about-grid-{{ ai_gen_id }}">
      <div class="ai-about-image-wrapper-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1200 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            class="ai-about-image-{{ ai_gen_id }}"
          >
        {% else %}
          <div class="ai-about-image-placeholder-{{ ai_gen_id }}">
            {{ 'lifestyle-1' | placeholder_svg_tag }}
          </div>
        {% endif %}
      </div>

      <div class="ai-about-content-{{ ai_gen_id }}">
        {% if block.settings.heading != blank %}
          <h2 class="ai-about-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.text != blank %}
          <div class="ai-about-text-{{ ai_gen_id }}">
            {{ block.settings.text }}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

