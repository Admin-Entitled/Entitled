<about-premium-{{ ai_gen_id }} class="ai-about-premium-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-about-content-{{ ai_gen_id }}">
    <div class="ai-hero-slider-{{ ai_gen_id }}">
      <div class="ai-hero-slides-{{ ai_gen_id }}">
        {% for i in (1..3) %}
          {% liquid
            assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
            assign slide_image_key = 'slide_' | append: i | append: '_image'
            assign slide_headline_key = 'slide_' | append: i | append: '_headline'
            assign slide_subline_key = 'slide_' | append: i | append: '_subline'

            assign slide_enabled = block.settings[slide_enabled_key]
            assign slide_image = block.settings[slide_image_key]
            assign slide_headline = block.settings[slide_headline_key]
            assign slide_subline = block.settings[slide_subline_key]
          %}

          {% if slide_enabled %}
            <div class="ai-hero-slide-{{ ai_gen_id }} {% if forloop.first %}ai-active-{{ ai_gen_id }}{% endif %}" data-slide="{{ i }}">
              {% if slide_image %}
                <img
                  src="{{ slide_image | image_url: width: 1920 }}"
                  alt="{{ slide_image.alt | escape }}"
                  class="ai-hero-slide-bg-{{ ai_gen_id }}"
                  loading="{% if forloop.first %}eager{% else %}lazy{% endif %}"
                  width="{{ slide_image.width }}"
                  height="{{ slide_image.height }}"
                >
              {% else %}
                <div class="ai-hero-slide-placeholder-{{ ai_gen_id }}">
                  {{ 'hero-apparel-1' | placeholder_svg_tag }}
                </div>
              {% endif %}
              <div class="ai-hero-slide-overlay-{{ ai_gen_id }}"></div>
              <div class="ai-hero-slide-content-{{ ai_gen_id }}">
                {% if slide_headline != blank %}
                  <h1 class="ai-hero-headline-{{ ai_gen_id }}">{{ slide_headline }}</h1>
                {% endif %}
                {% if slide_subline != blank %}
                  <p class="ai-hero-subline-{{ ai_gen_id }}">{{ slide_subline }}</p>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endfor %}
      </div>

      {% if block.settings.show_dots %}
        <div class="ai-hero-dots-{{ ai_gen_id }}">
          {% for i in (1..3) %}
            {% liquid
              assign slide_enabled_key = 'slide_' | append: i | append: '_enabled'
              assign slide_enabled = block.settings[slide_enabled_key]
            %}
            {% if slide_enabled %}
              <button
                class="ai-hero-dot-{{ ai_gen_id }} {% if forloop.first %}ai-active-{{ ai_gen_id }}{% endif %}"
                data-slide="{{ i }}"
                aria-label="Go to slide {{ i }}"
              ></button>
            {% endif %}
          {% endfor %}
        </div>
      {% endif %}
    </div>

    {% for i in (1..6) %}
      {% liquid
        assign section_enabled_key = 'section_' | append: i | append: '_enabled'
        assign section_title_key = 'section_' | append: i | append: '_title'
        assign section_content_key = 'section_' | append: i | append: '_content'
        assign section_image_key = 'section_' | append: i | append: '_image'
        assign section_layout_key = 'section_' | append: i | append: '_layout'

        assign section_enabled = block.settings[section_enabled_key]
        assign section_title = block.settings[section_title_key]
        assign section_content = block.settings[section_content_key]
        assign section_image = block.settings[section_image_key]
        assign section_layout = block.settings[section_layout_key]
      %}

      {% if section_enabled and section_title != blank %}
        <div class="ai-split-section-{{ ai_gen_id }} ai-section-{{ i }}-{{ ai_gen_id }}" data-section="{{ i }}">
          <div class="ai-split-container-{{ ai_gen_id }} {% if section_layout == 'text_left' %}ai-reverse-{{ ai_gen_id }}{% endif %}">
            <div class="ai-split-image-{{ ai_gen_id }}">
              <div class="ai-split-image-wrapper-{{ ai_gen_id }}">
                {% if section_image %}
                  <img
                    src="{{ section_image | image_url: width: 1000 }}"
                    alt="{{ section_image.alt | escape }}"
                    loading="lazy"
                    width="{{ section_image.width }}"
                    height="{{ section_image.height }}"
                  >
                {% else %}
                  <div class="ai-split-image-placeholder-{{ ai_gen_id }}">
                    {{ 'product-apparel-1' | placeholder_svg_tag }}
                  </div>
                {% endif %}
              </div>
            </div>
            <div class="ai-split-text-{{ ai_gen_id }}">
              <h2 class="ai-split-title-{{ ai_gen_id }}">{{ section_title }}</h2>
              <div class="ai-split-content-{{ ai_gen_id }}">{{ section_content }}</div>
            </div>
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</about-premium-{{ ai_gen_id }}>

<script>
  (function() {
    class AboutPremium{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentSlide = 0;
        this.slides = this.querySelectorAll('.ai-hero-slide-{{ ai_gen_id }}');
        this.dots = this.querySelectorAll('.ai-hero-dot-{{ ai_gen_id }}');
        this.sections = this.querySelectorAll('.ai-split-section-{{ ai_gen_id }}');
        this.autoplaySpeed = {{ block.settings.autoplay_speed | times: 1000 }};
        this.autoplayEnabled = {{ block.settings.enable_autoplay }};
        this.autoplayTimer = null;
      }

      connectedCallback() {
        this.setupSlider();
        this.setupIntersectionObserver();
      }

      setupSlider() {
        if (this.slides.length <= 1) return;

        this.dots.forEach((dot, index) => {
          dot.addEventListener('click', () => {
            this.goToSlide(index);
            if (this.autoplayEnabled) {
              this.resetAutoplay();
            }
          });
        });

        if (this.autoplayEnabled) {
          this.startAutoplay();
        }
      }

      goToSlide(index) {
        this.slides.forEach(slide => slide.classList.remove('ai-active-{{ ai_gen_id }}'));
        this.dots.forEach(dot => dot.classList.remove('ai-active-{{ ai_gen_id }}'));

        this.slides[index].classList.add('ai-active-{{ ai_gen_id }}');
        this.dots[index].classList.add('ai-active-{{ ai_gen_id }}');
        this.currentSlide = index;
      }

      startAutoplay() {
        this.autoplayTimer = setInterval(() => {
          const nextSlide = (this.currentSlide + 1) % this.slides.length;
          this.goToSlide(nextSlide);
        }, this.autoplaySpeed);
      }

      resetAutoplay() {
        clearInterval(this.autoplayTimer);
        this.startAutoplay();
      }

      setupIntersectionObserver() {
        if (!('IntersectionObserver' in window)) {
          this.sections.forEach(section => {
            section.classList.add('ai-visible-{{ ai_gen_id }}');
          });
          return;
        }

        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              entry.target.classList.add('ai-visible-{{ ai_gen_id }}');
              observer.unobserve(entry.target);
            }
          });
        }, {
          threshold: 0.15,
          rootMargin: '0px 0px -50px 0px'
        });

        this.sections.forEach(section => {
          observer.observe(section);
        });
      }

      disconnectedCallback() {
        if (this.autoplayTimer) {
          clearInterval(this.autoplayTimer);
        }
      }
    }

    customElements.define('about-premium-{{ ai_gen_id }}', AboutPremium{{ ai_gen_id }});
  })();
</script>

