    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity {{ block.settings.slide_transition_speed }}s ease-in-out;
    display: flex;
    align-items: center;
    justify-content: center;
