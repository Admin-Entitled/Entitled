NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-04

# Choose one Shopify authentication mode.

# Option 1: Static Admin API token (Recommended):
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Option 2: Client credentials:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional Order Mapping PostgreSQL Database:
DATABASE_URL=
DIRECT_DATABASE_URL=
ORDER_MAPPING_SCHEMA=order_mapping

# Meta Ads Dashboard Configuration (Read-only)
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=

