NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_API_VERSION=2026-04

# Choose one Shopify authentication mode.

# Option 1: Static Admin API token (Recommended):
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Option 2: Client credentials:
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

# Optional Order Mapping PostgreSQL Database:
DATABASE_URL=
DIRECT_DATABASE_URL=
ORDER_MAPPING_SCHEMA=order_mapping

# Meta Ads Dashboard Configuration (READ-ONLY)
# Meta (Facebook) Marketing API access token. Must have the following
# permissions on the system user / app: ads_read, read_insights, ads_management
# (read scope only — this dashboard never mutates campaigns, ad sets or ads).
# The token lives on the backend only and is never sent to the frontend.
META_ACCESS_TOKEN=

# Meta ad account ID (numeric, with or without the 'act_' prefix).
# The account's currency and timezone become the canonical reporting context.
META_AD_ACCOUNT_ID=

# Meta Graph / Marketing API version (centralized — do not scatter elsewhere).
# Defaults to the current stable version if unset.
META_API_VERSION=v26.0

