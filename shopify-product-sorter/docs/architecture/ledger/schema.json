{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ArchitectureLedgerTasks",
  "type": "object",
  "required": [
    "version",
    "last_updated",
    "tasks"
  ],
  "properties": {
    "version": {
      "type": "string",
      "enum": [
        "1.0.0"
      ]
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "tasks": {
      "type": "array",
      "items": {
        "$ref": "#/definitions/Task"
      }
    }
  },
  "definitions": {
    "Task": {
      "type": "object",
      "required": [
        "id",
        "title",
        "description",
        "severity",
        "status",
        "dependencies",
        "blocking_reasons",
        "acceptance_criteria",
        "validation_commands",
        "evidence",
        "changed_files",
        "created_timestamp",
        "updated_timestamp",
        "started_timestamp",
        "implemented_timestamp",
        "validated_timestamp",
        "completed_timestamp",
        "notes",
        "validation_files",
        "implementation_commit_sha",
        "clean_validation_commit_sha",
        "completion_record_commit_sha",
        "validation_results"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[A-Z0-9]+-[0-9]{3,4}$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string"
        },
        "severity": {
          "type": "string",
          "enum": [
            "CRITICAL",
            "HIGH",
            "MEDIUM",
            "LOW"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "not_started",
            "ready",
            "in_progress",
            "implemented",
            "validation_pending",
            "validated",
            "blocked",
            "completed",
            "deferred",
            "cancelled"
          ]
        },
        "dependencies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "blocking_reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "acceptance_criteria": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "validation_commands": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "evidence": {
          "type": [
            "string",
            "array"
          ],
          "items": {
            "type": "string"
          }
        },
        "changed_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "created_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "updated_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "started_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "implemented_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "validated_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "completed_timestamp": {
          "type": [
            "string",
            "null"
          ]
        },
        "notes": {
          "type": "string"
        },
        "validation_files": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "implementation_commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "clean_validation_commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "completion_record_commit_sha": {
          "type": [
            "string",
            "null"
          ]
        },
        "validation_results": {
          "type": [
            "object",
            "array",
            "null"
          ]
        }
      }
    }
  }
}
