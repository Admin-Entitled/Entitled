{
  "model": "gpt-image-2",
  "mode": "image2image",
  "media": "image",
  "jsonSchema": {
    "type": "object",
    "properties": {
      "prompt": { "type": "string", "minLength": 1 },
      "imageCount": { "default": 1, "type": "integer", "minimum": 1, "maximum": 8 },
      "aspectRatio": {
        "default": "4:3",
        "type": "string",
        "enum": ["1:1", "3:2", "2:3", "16:9", "9:16", "4:3", "3:4", "5:4", "4:5", "21:9", "9:21"]
      },
      "resolutionTier": { "default": "2k", "type": "string", "enum": ["1k", "2k", "4k"] },
      "lockAspectRatio": { "default": true, "type": "boolean" },
      "customWidth": { "type": "integer", "exclusiveMinimum": 0 },
      "customHeight": { "type": "integer", "exclusiveMinimum": 0 },
      "quality": {
        "default": "medium",
        "type": "string",
        "enum": ["low", "medium", "high", "auto"]
      },
      "outputFormat": { "default": "png", "type": "string", "enum": ["png", "jpeg", "webp"] },
      "outputCompression": { "type": "integer", "minimum": 0, "maximum": 100 },
      "visualReferences": {
        "maxItems": 16,
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "required": ["type", "id", "url", "label"],
          "properties": {
            "type": { "const": "image" },
            "id": { "type": "string" },
            "url": { "type": "string" },
            "label": { "type": "string" },
            "source": { "type": "string" },
            "name": { "type": "string" },
            "imageUrl": { "type": "string" },
            "thumbnailUrl": { "type": "string" }
          },
          "additionalProperties": false
        }
      },
      "autoEnhancePrompt": { "default": false, "type": "boolean" }
    },
    "required": ["prompt", "visualReferences"],
    "additionalProperties": false
  }
}
