<script>
(function() {
  class FaqSection{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.faqItems = this.querySelectorAll('.ai-faq-item-{{ ai_gen_id }}');
      this.setupEventListeners();
    }

    setupEventListeners() {
      this.faqItems.forEach((item) => {
        const button = item.querySelector('.ai-faq-question-{{ ai_gen_id }}');
        const answer = item.querySelector('.ai-faq-answer-{{ ai_gen_id }}');
        
        button.addEventListener('click', () => {
          const isActive = item.classList.contains('active');
          const column = item.closest('.ai-faq-column-{{ ai_gen_id }}');
          
          column.querySelectorAll('.ai-faq-item-{{ ai_gen_id }}').forEach((otherItem) => {
            if (otherItem !== item) {
              otherItem.classList.remove('active');
              otherItem.querySelector('.ai-faq-question-{{ ai_gen_id }}').setAttribute('aria-expanded', 'false');
            }
          });
          
          if (isActive) {
            item.classList.remove('active');
            button.setAttribute('aria-expanded', 'false');
          } else {
            item.classList.add('active');
            button.setAttribute('aria-expanded', 'true');
          }
        });
      });
    }
  }

  customElements.define('faq-section-{{ ai_gen_id }}', FaqSection{{ ai_gen_id }});
})();
</script>

