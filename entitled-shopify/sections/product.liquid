<!-- /templates/product.liquid -->
<!-- ENTITLED TEST MARK -->
<meta itemprop="url" content="{{ shop.url }}{{ product.url }}">
<meta itemprop="image" content="{{ product.featured_image.src | img_url: 'grande' }}">
<meta itemprop="priceCurrency" content="{{ shop.currency }}">
{% assign current_variant = product.selected_or_first_available_variant %}

<div class="header_height"></div>

{% if settings.show_breadcrumb %}
  <div class="breadcrumb_section">
    <div class="container">
      <div class="grid">
        <div class="grid__item one-whole">
          <div class="breadcrumb_item">
            {% include 'breadcrumb' %}
          </div>
        </div>
      </div>
    </div>
  </div>
{% endif %}

<div class="content">
  <div class="container">
    <div class="grid">
      {% if settings.product_slidebar %}
        <div class="grid__item three-twelfths small--one-whole medium--one-whole">
          {% include 'collection-sidebar' %}
        </div>
      {% endif %}

      <div class="grid__item nine-twelfths small--one-whole medium--one-whole">
        <div class="product-main-wrap">
          <div class="entitled-product-layout">

            <!-- LEFT COLUMN -->
            <div class="product_media_column">
              <div class="product_slider_section">
                <div class="slider_part">
                  <ul class="product_slider">
                    {% for image in product.images %}
                      <li>
                        <img src="{{ image.src | img_url: 'master' }}" alt="{{ image | escape }}">
                      </li>
                    {% endfor %}
                  </ul>
                </div>

                <ul style="display:none;">
                  {% assign featured_image = current_variant.featured_image | default: product.featured_image %}
                  <li>
                    <img
                      src="{{ featured_image | img_url: 'master' }}"
                      alt="{{ featured_image.alt | escape }}"
                      id="ProductPhotoImg"
                    >
                  </li>
                </ul>
              </div>

              <div class="product_pager_wrap">
                <div class="product_pager">
                  <div id="bx-pager">
                    {% for image in product.images %}
                      <div class="pager_item">
                        <a href="#" data-slide-index="{{ forloop.index0 }}">
                          <img src="{{ image.src | img_url: '300x300' }}" alt="{{ image.alt | escape }}">
                        </a>
                      </div>
                    {% endfor %}
                  </div>
                </div>
              </div>
            </div>

            <!-- RIGHT COLUMN -->
            <div
              class="product_info_panel"
              data-size-product-page
              itemscope
              itemtype="http://schema.org/Product"
            >
              <div class="product_header_block">
                <h1 class="product_page_title">{{ product.title }}</h1>
              </div>

              <form
                action="/cart/add"
                method="post"
                enctype="multipart/form-data"
                id="AddToCartForm"
                class="product_purchase_form"
              >
                <div class="right_specify product_detail">
                  <div class="detail_row price_row">
                    <h4><span>Price</span>:</h4>
                    <h3>
                      <span id="ProductPrice" class="h2">
                        {{ current_variant.price | money }}
                      </span>
                      {% if settings.compare_price_enable %}
                        {% if product.compare_at_price_max > product.price %}
                          <span class="compare_price" id="ComparePrice">
                            {{ current_variant.compare_at_price | money }}
                          </span>
                        {% endif %}
                      {% endif %}
                    </h3>
                  </div>

                  <select name="id" id="productSelect" class="product-single__variants">
                    {% for variant in product.variants %}
                      {% if variant.available %}
                        <option
                          {% if variant == product.selected_or_first_available_variant %}
                            selected="selected"
                          {% endif %}
                          data-sku="{{ variant.sku }}"
                          value="{{ variant.id }}"
                        >
                          {{ variant.title }} - {{ variant.price | money_with_currency }}
                        </option>
                      {% else %}
                        <option
                          {% if variant == product.selected_or_first_available_variant %}
                            selected="selected"
                          {% endif %}
                          disabled="disabled"
                          data-sku="{{ variant.sku }}"
                          value="{{ variant.id }}"
                        >
                          {{ variant.title }} - Sold Out
                        </option>
                      {% endif %}
                    {% endfor %}
                  </select>

                  {% unless product.variants.first.title == 'Default Title' %}
                    {% for option in product.options %}
                      <div class="detail_row color_row">
                        {% include 'swatch' with option %}
                      </div>
                    {% endfor %}

                    <div class="detail_row" id="chestSizeRow">
                      <h4><span>Chest Size</span>:</h4>
                      <p id="chestSizeValue">—</p>
                    </div>
                  {% endunless %}

                  <p class="product-size-preference" data-size-preference-product-status aria-live="polite" hidden></p>

                  {% if settings.enable_quantity %}
                    <div class="detail_row qty_row">
                      <h4>
                        <span>{{ 'products.product.quantity' | t }}</span>:
                      </h4>
                      <div class="qty_form">
                        <button type="button" class="plus"></button>
                        <input
                          type="text"
                          value="1"
                          readonly="readonly"
                          name="quantity"
                          class="product-quantity"
                          id="quantity"
                        >
                        <button type="button" class="minus"></button>
                      </div>
                    </div>
                  {% endif %}

                  {% assign sold_out = true %}
                  {% if product.available %}
                    {% assign sold_out = false %}
                  {% endif %}

                  <div class="detail_row submit_row">
                    {% if sold_out %}
                      <a href="javascript:void(0)" class="btn disabled">{{ 'products.product.sold_out' | t }}</a>
                    {% else %}
                      <button type="submit" name="add" id="AddToCart">
                        {{ 'products.product.add_to_cart' | t -}}
                        <span><i class="fa fa-angle-right"></i></span>
                      </button>
                    {% endif %}
                  </div>

                  <div class="product-info-tabs" data-product-info-tabs>
                    <div class="product-info-tabs__nav" role="tablist" aria-label="Product information">
                      <button
                        type="button"
                        class="product-info-tabs__tab is-active"
                        id="product-info-tab-washcare-{{ section.id }}"
                        data-product-info-tab="washcare"
                        role="tab"
                        aria-selected="true"
                        aria-controls="product-info-panel-washcare-{{ section.id }}"
                      >
                        Washcare
                      </button>
                      <button
                        type="button"
                        class="product-info-tabs__tab"
                        id="product-info-tab-shipping-{{ section.id }}"
                        data-product-info-tab="shipping"
                        role="tab"
                        aria-selected="false"
                        aria-controls="product-info-panel-shipping-{{ section.id }}"
                      >
                        Shipping
                      </button>
                    </div>

                    <div
                      class="product-info-tabs__panel is-active"
                      id="product-info-panel-washcare-{{ section.id }}"
                      data-product-info-panel="washcare"
                      role="tabpanel"
                      aria-labelledby="product-info-tab-washcare-{{ section.id }}"
                    >
                      <div class="product-info-tabs__content rte">
                        {% if product.metafields.custom.washcare != blank %}
                          {{ product.metafields.custom.washcare }}
                        {% elsif product.metafields.custom.wash_care != blank %}
                          {{ product.metafields.custom.wash_care }}
                        {% else %}
                          <p>Refer to the care instructions on the garment label for wash and handling guidance.</p>
                        {% endif %}
                      </div>
                    </div>

                    <div
                      class="product-info-tabs__panel"
                      id="product-info-panel-shipping-{{ section.id }}"
                      data-product-info-panel="shipping"
                      role="tabpanel"
                      aria-labelledby="product-info-tab-shipping-{{ section.id }}"
                      hidden
                    >
                      <div class="product-info-tabs__content rte">
                        <p>Prepaid Orders get faster delivery and free shipping</p>
                      </div>
                    </div>
                  </div>
                </div>
              </form>

              {% if settings.social_sharing_products %}
                <div class="product_social_block">
                  {% include 'social-sharing' %}
                </div>
              {% endif %}

              {% if settings.enable_wishlist %}
                <div class="product_wishlist_btn">
                  {% include 'wishlist-product' %}
                </div>
              {% endif %}
            </div>
          </div>
        </div>

        <div class="product-layout-clear"></div>

        {% if settings.enable_related_product %}
          <div class="related_products">
            {% include 'related-product' %}
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<script src="{{ 'option_selection.js' | shopify_asset_url }}" defer></script>
<script>
  var productTags = {{ product.tags | json }};
  var productData = {{ product | json }};
  var productOptionNames = {{ product.options | json }};

  function buildChestSizeMap(tags) {
    var map = {};
    var chestTagRegex = /^(XS|S|M|L|XL|XXL|XXXL)\s+Chest\s+Size:\s*(.+)$/i;

    for (var i = 0; i < (tags || []).length; i++) {
      var tag = String(tags[i] || "").trim();
      var match = tag.match(chestTagRegex);
      if (match) {
        map[match[1].toUpperCase()] = String(match[2] || "").trim();
      }
    }

    return map;
  }

  function extractSizeToken(input) {
    var text = String(input || "");
    var match = text.match(/\b(XXXL|XXL|XL|XS|S|M|L)\b/i);
    return match ? match[1].toUpperCase() : "";
  }

  function getSizeOptionIndex() {
    for (var i = 0; i < (productOptionNames || []).length; i++) {
      if (String(productOptionNames[i] || "").toLowerCase() === "size") return i;
    }
    return -1;
  }

  function getSizeFromSwatch() {
    var sizeOptionIndex = getSizeOptionIndex();
    var checked = jQuery('.swatch[data-option-index="' + sizeOptionIndex + '"] :radio:checked').first();
    if (!checked.length) return "";
    return extractSizeToken(checked.val());
  }

  function getSelectedVariantFromSelect() {
    var selectEl = document.getElementById("productSelect");
    if (!selectEl || !selectEl.value || !productData || !productData.variants) return null;

    for (var i = 0; i < productData.variants.length; i++) {
      if (String(productData.variants[i].id) === String(selectEl.value)) return productData.variants[i];
    }

    return null;
  }

  function getSizeFromVariant(variant) {
    if (!variant) return "";

    var sizeOptionIndex = getSizeOptionIndex();

    if (sizeOptionIndex < 0) return "";

    if (variant.options && variant.options.length > sizeOptionIndex) {
      var fromOptions = extractSizeToken(variant.options[sizeOptionIndex]);
      if (fromOptions) return fromOptions;
    }

    return "";
  }

  function getSizeFromProductSelectText() {
    var selectEl = document.getElementById("productSelect");
    if (!selectEl || selectEl.selectedIndex < 0) return "";

    return extractSizeToken(selectEl.options[selectEl.selectedIndex].text || "");
  }

  function detectSelectedSize(variant) {
    var fromSwatch = getSizeFromSwatch();
    if (fromSwatch) return fromSwatch;

    var fromVariant = getSizeFromVariant(variant || getSelectedVariantFromSelect());
    if (fromVariant) return fromVariant;

    return getSizeFromProductSelectText();
  }

  var chestSizeMap = buildChestSizeMap(productTags);

  function updateChestSize(variant) {
    var valueEl = document.getElementById("chestSizeValue");
    if (!valueEl) return;

    var size = detectSelectedSize(variant);
    valueEl.textContent = (size && chestSizeMap[size]) ? chestSizeMap[size] : "—";
  }

  var selectCallback = function(variant, selector) {
    if (variant) {
      $('.variant-sku').text(variant.sku);
    } else {
      $('.variant-sku').empty();
    }

    if (variant) {
      var form = jQuery('#' + selector.domIdPrefix).closest('form');
      for (var i = 0, length = variant.options.length; i < length; i++) {
        var radioButton = form.find('.swatch[data-option-index="' + i + '"] :radio[value="' + variant.options[i] + '"]');
        if (radioButton.size() && !radioButton.prop('disabled')) {
          radioButton.get(0).checked = true;
        }
      }
    }

    hulkthemes.productPage({
      money_format: "{{ shop.money_format }}",
      variant: variant,
      selector: selector
    });

    updateChestSize(variant);
  };

  jQuery(function($) {
    new Shopify.OptionSelectors('productSelect', {
      product: {{ product | json }},
      onVariantSelected: selectCallback,
      enableHistoryState: true
    });
    document.dispatchEvent(new CustomEvent('entitled:variant-selectors-ready'));

    updateChestSize();

    document.addEventListener('change', function(event) {
      if (event.target && event.target.id === 'productSelect') {
        updateChestSize();
      }
    });

    $(document).on('change', '.swatch :radio', function() {
      if ($(this).is(':disabled')) return false;
      updateChestSize();
    });

    $(document).on('click', '[data-product-info-tab]', function() {
      var $tab = $(this);
      var target = $tab.attr('data-product-info-tab');
      var $tabsRoot = $tab.closest('[data-product-info-tabs]');

      $tabsRoot.find('[data-product-info-tab]').removeClass('is-active').attr('aria-selected', 'false');
      $tabsRoot.find('[data-product-info-panel]').removeClass('is-active').attr('hidden', true);

      $tab.addClass('is-active').attr('aria-selected', 'true');
      $tabsRoot.find('[data-product-info-panel="' + target + '"]').addClass('is-active').removeAttr('hidden');
    });

    {% if product.options.size == 1 and product.options.first != 'Title' %}
      $('.selector-wrapper:eq(0)').prepend('<label for="productSelect-option-0">{{ product.options.first | escape }}</label>');
    {% endif %}

    {% if product.variants.size == 1 and product.variants.first.title contains 'Default' %}
      $('.selector-wrapper').hide();
    {% endif %}
  });
</script>
