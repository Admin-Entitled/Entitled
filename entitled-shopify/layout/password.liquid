<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0B0B0C">

    <title>
      {{ shop.name }}
      — Members-only
    </title>

    {{ content_for_header }}

    <style>
      :root{
        --base:#0B0B0C;
        --surface:#17181B;
        --light:#F2ECE2;
        --oxblood:#5B0A19;
      }

      *{ box-sizing:border-box; }
      html,body{ height:100%; }
      body{
        margin:0;
        background:var(--base);
        color:var(--light);
        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
        -webkit-font-smoothing:antialiased;
        -moz-osx-font-smoothing:grayscale;
      }
      a{ color:inherit; text-decoration:none; }

      /* Keep Shopify output present (required) but visually hidden */
      .shopify-layout{
        position:absolute;
        width:1px;height:1px;
        overflow:hidden;
        clip:rect(0 0 0 0);
        clip-path: inset(50%);
        white-space:nowrap;
      }

      /* Page */
      .page-root{
        position:relative;
        min-height:100vh;
        overflow:hidden;
      }

      /* Background */
      .bg-layer{
        pointer-events:none;
        position:absolute;
        inset:0;
      }
      .bg-layer .wash{
        position:absolute;
        inset:0;
        background:
          radial-gradient(1200px circle at 18% 12%, rgba(91,10,25,0.22), transparent 58%),
          radial-gradient(900px circle at 78% 22%, rgba(91,10,25,0.16), transparent 60%),
          linear-gradient(180deg, rgba(11,11,12,0.95), rgba(11,11,12,1));
      }
      .bg-layer .glow-a{
        position:absolute;
        left:-320px; top:-280px;
        width:980px; height:980px;
        border-radius:9999px;
        background:rgba(91,10,25,0.20);
        filter:blur(240px);
      }
      .bg-layer .glow-b{
        position:absolute;
        right:-420px; bottom:-400px;
        width:1100px; height:1100px;
        border-radius:9999px;
        background:rgba(91,10,25,0.16);
        filter:blur(260px);
      }
      .bg-layer .wash-2{
        position:absolute;
        inset:0;
        background:
          radial-gradient(1200px circle at 18% 12%, rgba(91,10,25,0.20), transparent 56%),
          radial-gradient(900px circle at 78% 22%, rgba(91,10,25,0.12), transparent 58%);
      }

      /* Grain */
      .grain{
        pointer-events:none;
        position:absolute;
        inset:0;
        opacity:0.05;
        background-image:
          linear-gradient(rgba(242,236,226,0.10) 1px, transparent 1px),
          linear-gradient(90deg, rgba(242,236,226,0.10) 1px, transparent 1px);
        background-size:3px 3px;
      }

      /* Layout wrapper */
      .wrap{
        position:relative;
        z-index:1;
        width:100%;
        max-width:1200px;
        margin:0 auto;
        padding:40px 24px 28px;
        min-height:100vh;
        display:flex;
        flex-direction:column;
      }

      /* Header */
      .header{
        display:flex;
        align-items:center;
        justify-content:space-between;
        gap:16px;
      }
      .brand{
        display:flex;
        align-items:center;
        gap:12px;
      }
      .badge{
        display:none;
        border:1px solid rgba(255,255,255,0.10);
        background:rgba(255,255,255,0.05);
        color:rgba(242,236,226,0.70);
        border-radius:9999px;
        padding:6px 12px;
        font-size:11px;
        letter-spacing:0.22em;
        text-transform:uppercase;
      }
      @media (min-width: 768px){
        .badge{ display:inline-flex; }
        .wrap{ padding:48px 40px 28px; }
      }

      /* Wordmark sizing */
      .wordmark{
        display:block;
        height:18px;
        width:auto;
        max-width:220px;
        object-fit:contain;
      }
      @media (max-width: 767px){
        .wordmark{
          height:16px;
          max-width:160px;
        }
      }

      /* Main grid */
      .main{
        margin:auto 0;
        padding:56px 0 56px;
      }
      .grid{
        position:relative;
        display:grid;
        grid-template-columns:1fr;
        gap:28px;
        align-items:center;
      }
      @media (min-width: 768px){
        .grid{
          grid-template-columns: 7fr 5fr;
          gap:32px;
        }
        .divider{
          position:absolute;
          top:15%;
          bottom:15%;
          left:58.333%;
          width:1px;
          transform:translateX(-50%);
          background:linear-gradient(to bottom, transparent, rgba(255,255,255,0.10), transparent);
        }
      }

      /* Panels */
      .panel{
        border:1px solid rgba(255,255,255,0.10);
        background:rgba(23,24,27,0.60);
        backdrop-filter: blur(16px);
        border-radius:24px;
        padding:28px;
      }
      @media (min-width: 768px){
        .panel{ padding:38px; }
      }
      .panel-strong{
        border:1px solid rgba(255,255,255,0.10);
        background:rgba(23,24,27,0.70);
        backdrop-filter: blur(18px);
        border-radius:24px;
        padding:28px;
        box-shadow:0 50px 170px rgba(0,0,0,0.75);
        max-width:380px;
      }
      @media (min-width: 768px){
        .panel-strong{ padding:40px; }
      }

      /* Typography */
      .eyebrow{
        font-size:11px;
        letter-spacing:0.22em;
        text-transform:uppercase;
        color:rgba(242,236,226,0.55);
        margin:0;
      }
      .hero{
        margin:14px 0 0;
        font-size:3.1rem;
        line-height:1.02;
        letter-spacing:-0.07em;
        font-weight:700;
        color:rgba(242,236,226,0.98);
      }
      @media (min-width: 768px){
        .hero{ font-size:3.6rem; }
      }
      .lead{
        margin:16px 0 0;
        font-size:1.02rem;
        line-height:1.65;
        color:rgba(242,236,226,0.72);
        max-width:46ch;
      }
      .list{
        margin:18px 0 0;
        padding-left:18px;
        color:rgba(255,255,255,0.95);
        line-height:1.45;
        font-size:0.98rem;
      }
      .list li{ margin:8px 0; }

      /* CTA button */
      .btn{
        height:40px;
        display:inline-flex;
        align-items:center;
        justify-content:center;
        border-radius:12px;
        padding:0 16px;
        font-size:14px;
        font-weight:600;
        transition: transform .12s ease, filter .15s ease, background .15s ease, box-shadow .15s ease;
        user-select:none;
        width:100%;
      }
      .btn:hover{ transform:scale(1.02); }
      .btn:active{ transform:scale(0.99); }

      .btn-primary{
        background:var(--oxblood);
        color:#fff;
        box-shadow:0 18px 55px rgba(91,10,25,0.35);
      }
      .btn-primary:hover{
        background:#6b0d1f;
        box-shadow:0 22px 65px rgba(107,13,31,0.45);
      }

      .cta-stack{
        display:grid;
        gap:10px;
        margin-top:18px;
      }

      .help{
        margin-top:16px;
        display:inline-flex;
        align-items:center;
        gap:10px;
        border:1px solid rgba(255,255,255,0.10);
        background:rgba(255,255,255,0.05);
        border-radius:12px;
        padding:12px 14px;
        font-size:12px;
        color:rgba(255,255,255,0.85);
      }
      .dot{
        width:10px;height:10px;
        border-radius:9999px;
        background:var(--oxblood);
        box-shadow:0 0 0 6px rgba(91,10,25,0.20);
      }

      .strip{
        margin-top:18px;
        border-radius:12px;
        border:1px solid rgba(255,255,255,0.10);
        background:rgba(0,0,0,0.25);
        padding:12px 14px;
        font-size:12px;
        color:rgba(255,255,255,0.80);
      }

      footer{
        margin-top:auto;
        padding-top:12px;
        font-size:12px;
        color:rgba(255,255,255,0.65);
      }
    </style>
  </head>

  <body>
    <!-- Shopify required output (hidden, but kept) -->
    <div class="shopify-layout">
      {{ content_for_layout }}
    </div>

    <div class="page-root">
      <div class="bg-layer" aria-hidden="true">
        <div class="wash"></div>
        <div class="glow-a"></div>
        <div class="glow-b"></div>
        <div class="wash-2"></div>
      </div>
      <div class="grain" aria-hidden="true"></div>

      <div class="wrap">
        <header class="header">
          <div class="brand">
            <a href="https://auth.entitledclub.com/login" aria-label="Entitled">
              <picture>
                <source
                  media="(max-width: 767px)"
                  srcset="{{ 'entitled-wordmark-mobile.png' | asset_url }}"
                >
                <img
                  class="wordmark"
                  src="{{ 'entitled-wordmark-desktop.png' | asset_url }}"
                  alt="Entitled"
                  width="220"
                  height="18"
                  loading="eager"
                >
              </picture>
            </a>

            <span class="badge">MEMBERS-ONLY</span>
          </div>
        </header>

        <section class="main">
          <div class="grid">
            <div class="divider" aria-hidden="true"></div>

            <!-- Left panel -->
            <div class="panel">
              <div style="display:flex; align-items:center; justify-content:center; gap:10px; margin:0 auto;">
                <span class="dot" aria-hidden="true"></span>
                <p class="eyebrow">private membership</p>
              </div>

              <h1 class="hero">Entitled</h1>

              <p class="lead">Members-only access to premium menswear at unbeatable value.</p>

              <ul class="list">
                <li>Curated drops. Limited quantities.</li>
                <li>Premium brands. Top-notch quality.</li>
                <li>Members-first support on WhatsApp.</li>
              </ul>

              <div class="help">
                <span class="dot" aria-hidden="true"></span>
                <span>Need help? WhatsApp Support</span>
              </div>
            </div>

            <!-- Right panel -->
            <div style="position:relative;">
              <div
                style="pointer-events:none; position:absolute; inset:-48px; border-radius:34px; background:rgba(91,10,25,0.10); filter:blur(48px);"
                aria-hidden="true"
              ></div>

              <div class="panel-strong">
                <p class="eyebrow" style="letter-spacing:0.28em;">vault access</p>
                <h2 style="margin:12px 0 0; font-size:1.8rem; letter-spacing:-0.04em; font-weight:700;">
                  Access Entitled
                </h2>
                <p class="lead" style="margin-top:10px;">Existing members log in instantly.</p>

                <div class="cta-stack">
                  <!-- ✅ Only ONE button -->
                  <a class="btn btn-primary" href="https://auth.entitledclub.com/login">Member Login</a>
                </div>

                <div class="strip">No OTP. No password. Phone verification against membership access.</div>
              </div>
            </div>
          </div>
        </section>

        <footer>© 2026 Entitled. Members-only.</footer>
      </div>
    </div>

    <script>
      document.addEventListener('DOMContentLoaded', function () {
        document.querySelectorAll("form[action='/password']").forEach(function (f) {
          f.remove();
        });
      });
    </script>
  </body>
</html>
