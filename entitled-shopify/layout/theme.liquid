    <style>
      /* Product image click cursor */
      .template-product .product_slider li img {
        cursor: zoom-in !important;
        pointer-events: auto !important;
        touch-action: manipulation !important;
      }

      /* Fullscreen image popup */
      .entitled-image-modal {
        position: fixed;
        inset: 0;
        background: rgba(0, 0, 0, 0.92);
        z-index: 999999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 24px;
        box-sizing: border-box;
      }

      .entitled-image-modal.is-open {
        display: flex;
      }

      .entitled-image-modal img {
        max-width: 94vw;
        max-height: 90vh;
        width: auto;
        height: auto;
        object-fit: contain;
        background: #f4f1ed;
        cursor: default !important;
        opacity: 1;
        transition: opacity 180ms ease;
      }

      .entitled-image-modal-close {
        position: fixed;
        top: 18px;
        right: 22px;
        z-index: 1000001;
        background: transparent !important;
        color: #ffffff !important;
        border: 0 !important;
        font-size: 38px;
        line-height: 1;
        padding: 0;
        cursor: pointer;
      }

      .entitled-modal-arrow {
        position: fixed;
        top: 50%;
        transform: translateY(-50%);
        z-index: 1000001;
        width: 42px;
        height: 42px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.94) !important;
        color: #111111 !important;
        border: 1px solid rgba(255, 255, 255, 0.35) !important;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 34px;
        line-height: 1;
        padding: 0;
        cursor: pointer;
      }

      .entitled-modal-prev {
        left: 24px;
      }

      .entitled-modal-next {
        right: 24px;
      }

      @media screen and (max-width: 767px) {
        .entitled-image-modal {
          padding: 14px;
        }

        .entitled-image-modal img {
          max-width: 92vw;
          max-height: 84vh;
        }

        .entitled-modal-arrow {
          display: none !important;
        }

        .entitled-modal-prev {
          left: 10px;
        }

        .entitled-modal-next {
          right: 10px;
        }

        .entitled-image-modal-close {
          top: 12px;
          right: 16px;
          font-size: 34px;
        }
      }
    </style>

    <script>
      document.addEventListener("DOMContentLoaded", function () {
        if (!document.body.classList.contains("template-product")) return;

        const slider = document.querySelector(".product_slider");
        const slides = Array.from(document.querySelectorAll(".product_slider li"));
        const pagerLinks = Array.from(document.querySelectorAll("#bx-pager a"));
        const sliderPart = document.querySelector(".product_slider_section .slider_part");

        if (!slider || !slides.length || !sliderPart) return;

        let currentIndex = 0;
        let lastTouchOpenTime = 0;
        let galleryTouchStartX = 0;
        let galleryTouchStartY = 0;
        let modalTouchStartX = 0;
        let modalTouchStartY = 0;
        let galleryTransitionTimer = null;

        slides.forEach(function (slide, index) {
          if (slide.classList.contains("active")) {
            currentIndex = index;
          }
        });

        function showSlide(index, direction) {
          if (index < 0) index = slides.length - 1;
          if (index >= slides.length) index = 0;

          const previousIndex = currentIndex;
          const hasChanged = previousIndex !== index;
          const incomingStart = direction === "prev" ? "-22px" : "22px";
          const outgoingEnd = direction === "prev" ? "22px" : "-22px";

          currentIndex = index;

          clearTimeout(galleryTransitionTimer);

          slides.forEach(function (slide, i) {
            const isCurrent = i === currentIndex;
            const wasPrevious = i === previousIndex;
            const shouldRender = isCurrent || (hasChanged && wasPrevious);

            slide.classList.toggle("active", isCurrent);
            slide.style.transition = hasChanged
              ? "opacity 420ms ease, transform 420ms cubic-bezier(0.22, 1, 0.36, 1)"
              : "none";
            slide.style.willChange = hasChanged ? "opacity, transform" : "";
            slide.style.display = shouldRender ? "flex" : "none";
            slide.style.opacity = isCurrent ? (hasChanged ? "0" : "1") : "0";
            slide.style.transform = isCurrent && hasChanged
              ? "translate3d(" + incomingStart + ", 0, 0) scale(0.985)"
              : "translate3d(0, 0, 0) scale(1)";
            slide.style.zIndex = isCurrent ? "50" : wasPrevious ? "49" : "0";
          });

          requestAnimationFrame(function () {
            requestAnimationFrame(function () {
              slides.forEach(function (slide, i) {
                if (i === currentIndex) {
                  slide.style.opacity = "1";
                  slide.style.transform = "translate3d(0, 0, 0) scale(1)";
                }

                if (i === previousIndex && i !== currentIndex) {
                  slide.style.opacity = "0";
                  slide.style.transform = "translate3d(" + outgoingEnd + ", 0, 0) scale(0.985)";
                }
              });
            });
          });

          galleryTransitionTimer = setTimeout(function () {
            slides.forEach(function (slide, i) {
              if (i !== currentIndex) {
                slide.style.display = "none";
                slide.style.zIndex = "0";
                slide.style.transform = "translate3d(0, 0, 0) scale(1)";
              }
              slide.style.willChange = "";
            });
          }, 460);

          pagerLinks.forEach(function (link, i) {
            link.classList.toggle("active", i === currentIndex);
          });
        }

        pagerLinks.forEach(function (link, index) {
          link.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();
            showSlide(index, index > currentIndex ? "next" : "prev");
          });
        });

        if (!sliderPart.querySelector(".entitled-gallery-prev")) {
          const prevBtn = document.createElement("button");
          prevBtn.type = "button";
          prevBtn.className = "entitled-gallery-arrow entitled-gallery-prev";
          prevBtn.innerHTML = "‹";

          const nextBtn = document.createElement("button");
          nextBtn.type = "button";
          nextBtn.className = "entitled-gallery-arrow entitled-gallery-next";
          nextBtn.innerHTML = "›";

          sliderPart.appendChild(prevBtn);
          sliderPart.appendChild(nextBtn);

          prevBtn.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();
            showSlide(currentIndex - 1, "prev");
          });

          nextBtn.addEventListener("click", function (e) {
            e.preventDefault();
            e.stopPropagation();
            showSlide(currentIndex + 1, "next");
          });
        }

        showSlide(currentIndex);

        const modal = document.createElement("div");
        modal.className = "entitled-image-modal";
        modal.innerHTML = `
          <button type="button" class="entitled-image-modal-close" aria-label="Close">×</button>
          <button type="button" class="entitled-modal-arrow entitled-modal-prev" aria-label="Previous image">‹</button>
          <img src="data:image/gif;base64,R0lGODlhAQABAAAAACw=" alt="" hidden>
          <button type="button" class="entitled-modal-arrow entitled-modal-next" aria-label="Next image">›</button>
        `;
        document.body.appendChild(modal);

        const modalImg = modal.querySelector("img");
        const closeBtn = modal.querySelector(".entitled-image-modal-close");
        const modalPrev = modal.querySelector(".entitled-modal-prev");
        const modalNext = modal.querySelector(".entitled-modal-next");

        function getLargeShopifyImage(src) {
          if (!src) return "";

          src = src.startsWith("//") ? "https:" + src : src;

          return src.replace(
            /_(pico|icon|thumb|small|compact|medium|large|grande|1024x1024|2048x2048|\d+x\d+)(\.[a-zA-Z0-9]+)(\?v=\d+)?/,
            "$2$3"
          );
        }

        function getSlideImage(index) {
          const slide = slides[index];
          if (!slide) return null;
          return slide.querySelector("img");
        }

        function updateModalImage(index) {
          if (index < 0) index = slides.length - 1;
          if (index >= slides.length) index = 0;

          currentIndex = index;

          const img = getSlideImage(currentIndex);
          if (!img) return;

          const src = img.currentSrc || img.getAttribute("src");
          const nextSrc = getLargeShopifyImage(src);

          if (modalImg.src) {
            modalImg.style.opacity = "0";
            setTimeout(function () {
              modalImg.hidden = false;
              modalImg.src = nextSrc;
              modalImg.style.opacity = "1";
            }, 90);
          } else {
            modalImg.hidden = false;
            modalImg.src = nextSrc;
            modalImg.style.opacity = "1";
          }

          showSlide(currentIndex);
        }

        function openModal(index) {
          updateModalImage(index);
          modal.classList.add("is-open");
          document.body.style.overflow = "hidden";
        }

        function closeModal() {
          modal.classList.remove("is-open");
          modalImg.src = "data:image/gif;base64,R0lGODlhAQABAAAAACw=";
          modalImg.hidden = true;
          document.body.style.overflow = "";
        }

        function getClickedProductImage(target) {
          return target && target.closest
            ? target.closest(".template-product .product_slider li img")
            : null;
        }

        function openFromProductImage(e) {
          const img = getClickedProductImage(e.target);
          if (!img) return;

          e.preventDefault();
          e.stopPropagation();

          const clickedSlide = img.closest("li");
          const index = slides.indexOf(clickedSlide);

          openModal(index >= 0 ? index : currentIndex);
        }

        /* Desktop click */
        document.addEventListener(
          "click",
          function (e) {
            if (Date.now() - lastTouchOpenTime < 600) return;
            openFromProductImage(e);
          },
          true
        );

        document.addEventListener(
          "touchstart",
          function (e) {
            const img = getClickedProductImage(e.target);
            if (!img || !e.changedTouches || !e.changedTouches.length) return;

            galleryTouchStartX = e.changedTouches[0].clientX;
            galleryTouchStartY = e.changedTouches[0].clientY;
          },
          { passive: true, capture: true }
        );

        /* Mobile tap and swipe */
        document.addEventListener(
          "touchend",
          function (e) {
            const img = getClickedProductImage(e.target);
            if (!img) return;

            const touch = e.changedTouches && e.changedTouches[0];
            const diffX = touch ? touch.clientX - galleryTouchStartX : 0;
            const diffY = touch ? touch.clientY - galleryTouchStartY : 0;

            if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY) * 1.4) {
              e.preventDefault();
              e.stopPropagation();
              lastTouchOpenTime = Date.now();
              showSlide(diffX < 0 ? currentIndex + 1 : currentIndex - 1, diffX < 0 ? "next" : "prev");
              return;
            }

            lastTouchOpenTime = Date.now();
            openFromProductImage(e);
          },
          { passive: false, capture: true }
        );

        closeBtn.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          closeModal();
        });

        modalPrev.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          updateModalImage(currentIndex - 1);
        });

        modalNext.addEventListener("click", function (e) {
          e.preventDefault();
          e.stopPropagation();
          updateModalImage(currentIndex + 1);
        });

        closeBtn.addEventListener(
          "touchend",
          function (e) {
            e.preventDefault();
            e.stopPropagation();
            closeModal();
          },
          { passive: false }
        );

        modalPrev.addEventListener(
          "touchend",
          function (e) {
            e.preventDefault();
            e.stopPropagation();
            updateModalImage(currentIndex - 1);
          },
          { passive: false }
        );

        modalNext.addEventListener(
          "touchend",
          function (e) {
            e.preventDefault();
            e.stopPropagation();
            updateModalImage(currentIndex + 1);
          },
          { passive: false }
        );

        modal.addEventListener(
          "touchstart",
          function (e) {
            if (!e.changedTouches || !e.changedTouches.length) return;
            modalTouchStartX = e.changedTouches[0].clientX;
            modalTouchStartY = e.changedTouches[0].clientY;
          },
          { passive: true }
        );

        modal.addEventListener(
          "touchend",
          function (e) {
            if (!modal.classList.contains("is-open")) return;
            if (!e.changedTouches || !e.changedTouches.length) return;

            const diffX = e.changedTouches[0].clientX - modalTouchStartX;
            const diffY = e.changedTouches[0].clientY - modalTouchStartY;

            if (Math.abs(diffX) > 45 && Math.abs(diffX) > Math.abs(diffY) * 1.4) {
              e.preventDefault();
              e.stopPropagation();
              updateModalImage(diffX < 0 ? currentIndex + 1 : currentIndex - 1);
            }
          },
          { passive: false }
        );

        modal.addEventListener("click", function (e) {
          if (e.target === modal) {
            closeModal();
          }
        });

        modal.addEventListener(
          "touchend",
          function (e) {
            if (e.target === modal) {
              e.preventDefault();
              closeModal();
            }
          },
          { passive: false }
        );

        document.addEventListener("keydown", function (e) {
          if (!modal.classList.contains("is-open")) return;

          if (e.key === "Escape") {
            closeModal();
          }

          if (e.key === "ArrowLeft") {
            updateModalImage(currentIndex - 1);
          }

          if (e.key === "ArrowRight") {
            updateModalImage(currentIndex + 1);
          }
        });
      });
    </script>
  </body>
</html>
