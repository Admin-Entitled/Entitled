{% doc %}
  @prompt
    Create a Shopify section named “FAQ Glossary”.
    
    Layout:
    - Three text items in columns
    - Stack on mobile
    
    Content items:
    - Member price (not discount)
    - Archived (drop closed)
    - Verified (meets standard)
    
    Settings:
    - Background gradient picker
    - Font picker
    - Spacing control
    - Border or divider toggle
    - Hover effect toggle (subtle lift)
    
    Design:
    - Editorial
    - Minimal cards
    
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-faq-glossary-{{ ai_gen_id }} {
    display: block;
    width: 100%;
    padding: {{ block.settings.spacing_top }}px 20px {{ block.settings.spacing_bottom }}px;
    background: {{ block.settings.background_gradient }};
  }

  .ai-faq-glossary-container-{{ ai_gen_id }} {
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-faq-glossary-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ block.settings.card_gap }}px;
  }

  .ai-faq-glossary-card-{{ ai_gen_id }} {
    background: #ffffff;
    padding: {{ block.settings.card_padding }}px;
    {% if block.settings.show_border %}
      border: 1px solid {{ block.settings.border_color }};
    {% endif %}
    border-radius: {{ block.settings.border_radius }}px;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  {% if block.settings.enable_hover_effect %}
    .ai-faq-glossary-card-{{ ai_gen_id }}:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 16px rgba(0, 0, 0, 0.08);
    }
  {% endif %}

  .ai-faq-glossary-term-{{ ai_gen_id }} {
    font-family: {{ block.settings.heading_font.family }}, {{ block.settings.heading_font.fallback_families }};
    font-weight: {{ block.settings.heading_font.weight }};
    font-style: {{ block.settings.heading_font.style }};
    font-size: {{ block.settings.term_font_size }}px;
    color: {{ block.settings.term_color }};
    margin: 0 0 {{ block.settings.term_spacing }}px 0;
    line-height: 1.3;
    letter-spacing: 0.02em;
  }

  .ai-faq-glossary-definition-{{ ai_gen_id }} {
    font-family: {{ block.settings.body_font.family }}, {{ block.settings.body_font.fallback_families }};
    font-weight: {{ block.settings.body_font.weight }};
    font-style: {{ block.settings.body_font.style }};
    font-size: {{ block.settings.definition_font_size }}px;
    color: {{ block.settings.definition_color }};
    line-height: 1.6;
    margin: 0;
  }

  {% if block.settings.show_divider %}
    .ai-faq-glossary-card-{{ ai_gen_id }}::after {
      content: '';
      display: block;
      width: 40px;
      height: 1px;
      background-color: {{ block.settings.divider_color }};
      margin-top: {{ block.settings.term_spacing }}px;
      margin-bottom: {{ block.settings.term_spacing }}px;
    }

    .ai-faq-glossary-definition-{{ ai_gen_id }} {
      margin-top: {{ block.settings.term_spacing }}px;
    }
  {% endif %}

  @media screen and (max-width: 989px) {
    .ai-faq-glossary-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ block.settings.card_gap | times: 0.75 }}px;
    }

    .ai-faq-glossary-term-{{ ai_gen_id }} {
      font-size: {{ block.settings.term_font_size | times: 0.9 }}px;
    }

    .ai-faq-glossary-definition-{{ ai_gen_id }} {
      font-size: {{ block.settings.definition_font_size | times: 0.9 }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-faq-glossary-{{ ai_gen_id }} {
      padding: {{ block.settings.spacing_top | times: 0.6 }}px 16px {{ block.settings.spacing_bottom | times: 0.6 }}px;
    }

    .ai-faq-glossary-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: {{ block.settings.card_gap | times: 0.5 }}px;
    }

    .ai-faq-glossary-card-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }
  }
{% endstyle %}

<faq-glossary-{{ ai_gen_id }} class="ai-faq-glossary-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-faq-glossary-container-{{ ai_gen_id }}">
    <div class="ai-faq-glossary-grid-{{ ai_gen_id }}">
      <div class="ai-faq-glossary-card-{{ ai_gen_id }}">
        <h3 class="ai-faq-glossary-term-{{ ai_gen_id }}">{{ block.settings.term_1 }}</h3>
        <div class="ai-faq-glossary-definition-{{ ai_gen_id }}">{{ block.settings.definition_1 }}</div>
      </div>

      <div class="ai-faq-glossary-card-{{ ai_gen_id }}">
        <h3 class="ai-faq-glossary-term-{{ ai_gen_id }}">{{ block.settings.term_2 }}</h3>
        <div class="ai-faq-glossary-definition-{{ ai_gen_id }}">{{ block.settings.definition_2 }}</div>
      </div>

      <div class="ai-faq-glossary-card-{{ ai_gen_id }}">
        <h3 class="ai-faq-glossary-term-{{ ai_gen_id }}">{{ block.settings.term_3 }}</h3>
        <div class="ai-faq-glossary-definition-{{ ai_gen_id }}">{{ block.settings.definition_3 }}</div>
      </div>
    </div>
  </div>
</faq-glossary-{{ ai_gen_id }}>

<script>
  (function() {
    class FaqGlossary{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.cards = this.querySelectorAll('.ai-faq-glossary-card-{{ ai_gen_id }}');
      }
    }

    customElements.define('faq-glossary-{{ ai_gen_id }}', FaqGlossary{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "FAQ glossary",
  "settings": [
    {
      "type": "header",
      "content": "Term 1"
    },
    {
      "type": "text",
      "id": "term_1",
      "label": "Term",
      "default": "Member price"
    },
    {
      "type": "richtext",
      "id": "definition_1",
      "label": "Definition",
      "default": "<p>Exclusive pricing available to verified members. Not a discount—a different tier entirely.</p>"
    },
    {
      "type": "header",
      "content": "Term 2"
    },
    {
      "type": "text",
      "id": "term_2",
      "label": "Term",
      "default": "Archived"
    },
    {
      "type": "richtext",
      "id": "definition_2",
      "label": "Definition",
      "default": "<p>Drop closed. No longer available for purchase. Once it's gone, it's archived.</p>"
    },
    {
      "type": "header",
      "content": "Term 3"
    },
    {
      "type": "text",
      "id": "term_3",
      "label": "Term",
      "default": "Verified"
    },
    {
      "type": "richtext",
      "id": "definition_3",
      "label": "Definition",
      "default": "<p>Meets our standard. Authenticated, quality-checked, and approved for the collection.</p>"
    },
    {
      "type": "header",
      "content": "Background"
    },
    {
      "type": "color_background",
      "id": "background_gradient",
      "label": "Background",
      "default": "linear-gradient(180deg, rgba(255, 255, 255, 1) 0%, rgba(250, 250, 250, 1) 100%)"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Term font",
      "default": "helvetica_n7"
    },
    {
      "type": "range",
      "id": "term_font_size",
      "label": "Term size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "default": 18
    },
    {
      "type": "color",
      "id": "term_color",
      "label": "Term color",
      "default": "#000000"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Definition font",
      "default": "helvetica_n4"
    },
    {
      "type": "range",
      "id": "definition_font_size",
      "label": "Definition size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "color",
      "id": "definition_color",
      "label": "Definition color",
      "default": "#666666"
    },
    {
      "type": "header",
      "content": "Card style"
    },
    {
      "type": "range",
      "id": "card_padding",
      "label": "Card padding",
      "min": 16,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "card_gap",
      "label": "Gap between cards",
      "min": 12,
      "max": 48,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "border_radius",
      "label": "Corner radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_border",
      "label": "Show border",
      "default": true
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#e5e5e5"
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider line",
      "default": true
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#d63612"
    },
    {
      "type": "checkbox",
      "id": "enable_hover_effect",
      "label": "Enable hover lift",
      "default": true
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "term_spacing",
      "label": "Term spacing",
      "min": 8,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 12
    },
    {
      "type": "range",
      "id": "spacing_top",
      "label": "Top spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    },
    {
      "type": "range",
      "id": "spacing_bottom",
      "label": "Bottom spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 60
    }
  ],
  "presets": [
    {
      "name": "FAQ glossary"
    }
  ]
}
{% endschema %}
